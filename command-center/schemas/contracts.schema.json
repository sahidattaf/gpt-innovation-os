{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptinnovation.local/command-center/contracts.schema.json",
  "title": "GPT Innovation Command Center Pilot Contracts",
  "$defs": {
    "OwnerCommand": {
      "type": "object",
      "required": ["command_id", "objective", "scope", "excluded_scope", "priority", "permitted_sources", "input_method", "submitted_by", "submitted_at", "status"],
      "properties": {
        "command_id": {"type": "string", "pattern": "^GIC-[0-9]{8}-[0-9]{3}$"},
        "schema_version": {"const": "1.0"},
        "objective": {"type": "string", "minLength": 1},
        "deliverable": {"type": ["string", "null"]},
        "scope": {"type": "string", "minLength": 1},
        "excluded_scope": {"type": "string", "minLength": 1},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "deadline": {"type": ["string", "null"]},
        "permitted_sources": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "input_method": {"enum": ["NOTION_FORM", "STRUCTURED_PROMPT", "VOICE_NOTE"]},
        "voice_verified": {"type": ["boolean", "null"]},
        "submitted_by": {"type": "string"},
        "submitted_at": {"type": "string"},
        "status": {"enum": ["DRAFT", "RECEIVED", "NEEDS_CLARIFICATION", "SCOPE_CHECK", "BLOCKED_SCOPE", "SOURCE_CHECK", "NEEDS_SOURCE_APPROVAL", "CONTEXT_READY", "ANALYSIS", "VALIDATION", "NEEDS_REVISION", "READY_FOR_APPROVAL", "APPROVED", "REJECTED", "ARCHIVED", "ERROR"]}
      },
      "additionalProperties": false
    },
    "EvidenceItem": {
      "type": "object",
      "required": ["evidence_id", "command_id", "classification", "claim", "confidence", "conflict_status"],
      "properties": {
        "evidence_id": {"type": "string"},
        "command_id": {"type": "string"},
        "classification": {"enum": ["VERIFIED_SOURCE", "OWNER_DECISION", "OWNER_UNVERIFIED_FACT", "EXTERNAL_RESEARCH", "AI_INFERENCE", "UNKNOWN"]},
        "claim": {"type": "string"},
        "source_name": {"type": ["string", "null"]},
        "source_type": {"type": ["string", "null"]},
        "source_reference": {"type": ["string", "null"]},
        "source_version": {"type": ["string", "null"]},
        "retrieved_at": {"type": ["string", "null"]},
        "conflict_status": {"enum": ["NONE", "UNRESOLVED", "RESOLVED_BY_PRECEDENCE", "RESOLVED_BY_OWNER"]},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "ApprovalRecord": {
      "type": "object",
      "required": ["approval_id", "command_id", "packet_version", "decision", "approver", "timestamp", "method", "evidence_reference", "valid"],
      "properties": {
        "approval_id": {"type": "string"},
        "command_id": {"type": "string"},
        "packet_version": {"type": "string"},
        "decision": {"enum": ["APPROVED", "REVISE", "REJECTED"]},
        "approver": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "minLength": 1},
        "method": {"enum": ["SIGNED_PDF", "NOTION", "CHAT"]},
        "evidence_reference": {"type": "string", "minLength": 1},
        "valid": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "AuditEvent": {
      "type": "object",
      "required": ["event_id", "command_id", "timestamp", "actor", "event_type", "object_type", "object_id", "result"],
      "properties": {
        "event_id": {"type": "string"},
        "command_id": {"type": "string"},
        "timestamp": {"type": "string"},
        "actor": {"enum": ["OWNER", "AI_OPERATOR", "SYSTEM"]},
        "event_type": {"type": "string"},
        "object_type": {"type": "string"},
        "object_id": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "status_before": {"type": ["string", "null"]},
        "status_after": {"type": ["string", "null"]},
        "policy_rule": {"type": ["string", "null"]},
        "result": {"type": "string"}
      },
      "additionalProperties": false
    },
    "AIRun": {
      "type": "object",
      "required": ["run_id", "command_id", "stage", "model", "status"],
      "properties": {
        "run_id": {"type": "string"},
        "command_id": {"type": "string"},
        "stage": {"type": "string"},
        "model": {"type": "string"},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "estimated_cost_xcg": {"type": ["number", "null"], "minimum": 0},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "status": {"enum": ["SUCCESS", "FAIL"]}
      },
      "additionalProperties": false
    }
  }
}

{
  "name": "gpt-innovation-os",
  "version": "1.0.0",
  "private": true,
  "description": "GPT Innovation OS — a full-stack AI operating system for entrepreneurs",
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "postcss": "8.5.23",
      "nanoid": "3.3.18",
      "form-data": "4.0.6",
      "source-map-js": "1.2.2",
      "brace-expansion@1": "1.1.21",
      "js-yaml": "4.3.2"
    }
  }
}
